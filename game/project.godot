; Generated by build-godot-games.
config_version=5

[application]
config/name="Ashen Veil"
config/icon="res://art/pixel/ashen-veil-icon-256.png"
run/main_scene="res://scenes/main.tscn"

[autoload]
Audio="*res://systems/audio.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[physics]
common/physics_ticks_per_second=60

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadButton,"button_index":0)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventKey,"physical_keycode":87)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}

sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
kick={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76)]}
ranged_attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}
power_attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":85)]}

energy_attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":88), Object(InputEventKey,"physical_keycode":71)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
2d/snap/snap_2d_transforms_to_pixel=true

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true
