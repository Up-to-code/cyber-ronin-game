extends SceneTree
var p: CharacterBody2D
var shots: Array=[]
func _initialize():call_deferred("run")
func ticks(n: int):
 for i in range(n):await physics_frame;await process_frame
func tap(action: String):
 Input.action_press(action);await ticks(1);Input.action_release(action)
func run():
 create_timer(15,true,false,true).timeout.connect(func():quit(1))
 p=load("res://actors/player_2d.gd").new();p.position=Vector2(600,600);p.map_bottom=3000;p.map_width=4000;root.add_child(p)
 p.projectile_requested.connect(func(kind,at,aim,source):shots.append({"kind":kind,"aim":aim}))
 p.set_submerged(true)
 await ticks(15)
 assert(p.velocity.y<0 and p.velocity.y>=-19,"Neutral water buoyancy replaces gravity")
 Input.action_press("move_right");Input.action_press("jump");await ticks(30)
 assert(p.velocity.x>80 and p.velocity.y< -80,"Space swims up while steering")
 assert(absf(p.rig.body_pivot.rotation)>.3,"Swimming pitches the authored body")
 Input.action_release("jump");Input.action_release("move_right")
 var vx: float=p.velocity.x;await ticks(2)
 assert(p.velocity.x>0 and p.velocity.x<vx,"Release drag preserves short inertia")
 Input.action_press("move_down");await ticks(45)
 assert(p.velocity.y>100 and not p.fast_falling and p.drop_left==0)
 Input.action_release("move_down")
 p.grant_relic("laser");await tap("energy_attack")
 assert(p.relic_charges.laser==1 and get_nodes_in_group("combat_projectiles").is_empty(),"Sun does not ignite in water")
 await tap("ranged_attack")
 assert(shots.size()==1 and shots[0].kind=="water" and p.power<90)
 await ticks(40)
 Input.action_press("move_left");await tap("attack")
 assert(p.sword_motion=="air_sword" and p.facing<0)
 await ticks(8);Input.action_release("move_left");Input.action_press("move_right");await ticks(2)
 assert(p.facing>0,"J remains reversible while swimming")
 Input.action_release("move_right")
 p.swim_current=Vector2(1000,0);p.velocity=Vector2.ZERO;await ticks(60)
 assert(p.velocity.x<=141 and p.velocity.x>100,"External current capped at 140")
 p.set_submerged(false)
 assert(p.rig.body_pivot.rotation==0 and p.attack_time==0 and p.relic_charges.laser==1)
 var start_y: float=p.velocity.y;await ticks(8)
 assert(p.velocity.y>start_y,"Land gravity resumes")
 p.set_submerged(true);p.reset_motion_presentation();assert(not p.submerged)
 root.get_node("Audio").shutdown()
 print("PASS: buoyancy, 2D steering, space ascent/down descent, drag, swim pitch, no sun/fire, water projectile cost, reversing J, surface/ retry restoration")
 quit()
