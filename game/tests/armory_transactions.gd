extends SceneTree
const Store = preload("res://systems/run/save_store.gd")
const Inventory = preload("res://systems/skill_inventory.gd")
const Armory = preload("res://systems/run/armory_transactions.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var path := "user://armory-transactions-test.cfg"
	var shared := ConfigFile.new()
	shared.set_value("audio", "volume", 0.4)
	var model := Inventory.new()
	var disk := Store.new(shared, path)
	disk.set_coins(1000);disk.set_skill_state(model.export_state())
	assert(disk.save() == OK)
	var writes := [0]
	var failing := Store.new(shared, path, func(_file: ConfigFile, _target: String) -> Error:
		writes[0] += 1
		return ERR_CANT_CREATE)
	var armory := Armory.new(model, failing)
	assert(not armory.purchase("sword", 1, path).ok and writes[0] == 0)
	assert(not armory.purchase("missing", 1000, path).ok and writes[0] == 0)
	var result: Dictionary = armory.purchase("sword", 1000, path)
	assert(not result.ok and result.wallet == 1000 and writes[0] == 1)
	assert(model.ranks.sword == 0 and failing.coins() == 1000)
	assert(failing.skill_state().ranks.sword == 0, "Failed purchase cannot leak into shared settings")
	# A later HUD-style save/reload must not resurrect the cancelled purchase.
	shared.set_value("audio", "volume", 0.8)
	assert(shared.save(path) == OK)
	var loaded := ConfigFile.new();assert(loaded.load(path) == OK)
	assert(loaded.get_value("skills", "state").ranks.sword == 0)
	assert(loaded.get_value("progress", "coins") == 1000)
	# A real rename failure must also leave shared state untouched and clean its temp file.
	var blocked := "user://armory-blocked-%d" % Time.get_ticks_usec()
	assert(DirAccess.make_dir_absolute(ProjectSettings.globalize_path(blocked)) == OK)
	assert(disk.commit_progress(820, {"ranks":{"sword":1}}, blocked) != OK)
	assert(disk.coins() == 1000 and disk.skill_state().ranks.sword == 0)
	assert(not FileAccess.file_exists(blocked + ".tmp"))
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(blocked)) == OK)
	armory = Armory.new(model, disk)
	result = armory.purchase("sword", 1000, path)
	assert(result.ok and result.wallet == 820 and model.ranks.sword == 1)
	assert(loaded.load(path) == OK)
	assert(loaded.get_value("skills", "state").ranks.sword == 1)
	assert(loaded.get_value("progress", "coins") == 820)
	assert(loaded.get_value("audio", "volume") == 0.8, "Purchase preserves display/audio settings")
	result = armory.purchase("heal", 820, path)
	assert(result.ok and result.wallet == 700 and model.charges.heal == 3)
	assert(not armory.purchase("heal", 700, path).ok)
	assert(model.consume("heal"))
	# Gameplay consumption is retained in memory even if saving fails.
	armory = Armory.new(model, failing)
	assert(armory.save_progress(700, path) != OK)
	assert(model.charges.heal == 2 and failing.skill_state().charges.heal == 2)
	assert(shared.save(path) == OK)
	assert(loaded.load(path) == OK and loaded.get_value("skills", "state").charges.heal == 2)
	var restart := Inventory.new();restart.load_state(Store.new(loaded, path).skill_state())
	assert(restart.ranks.sword == 1 and restart.charges.heal == 2)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	assert(not FileAccess.file_exists(path + ".tmp"))
	print("PASS armory transactions: failed-write isolation, later settings save, purchase commit, wallet, caps, settings preservation, consumption and restart")
	quit()
