extends SceneTree
func _initialize():call_deferred("run")
func run():
 var model=load("res://systems/skill_inventory.gd").new()
 assert(not model.purchase("sword",1).ok and model.ranks.sword==0)
 var result=model.purchase("sword",500);assert(result.ok and result.wallet==320 and model.ranks.sword==1)
 for i in range(4):assert(model.purchase("sword",10000).ok)
 assert(not model.purchase("sword",10000).ok)
 assert(model.purchase("heal",500).ok and model.charges.heal==3)
 assert(not model.purchase("heal",500).ok,"Never overwrite remaining stock")
 var p=load("res://actors/player_2d.gd").new();root.add_child(p);p.set_physics_process(false)
 p.apply_skill_inventory(model,true)
 assert(is_equal_approx(p.sword_damage_multiplier,1.75))
 assert(not p.use_inventory_skill("heal") and model.charges.heal==3)
 p.health=10;assert(p.use_inventory_skill("heal"));assert(p.health==65 and model.charges.heal==2)
 p.reset_motion_presentation();p.apply_skill_inventory(model,true)
 assert(model.charges.heal==2,"Retry does not regenerate spent charge")
 var restored=load("res://systems/skill_inventory.gd").new();restored.load_state(model.export_state())
 assert(restored.charges.heal==2 and restored.ranks.sword==5)
 restored.load_state({"ranks":{"sword":99,"vitality":-1},"charges":{"heal":99}})
 assert(restored.ranks.sword==5 and restored.ranks.vitality==0 and restored.charges.heal==3)
 root.get_node("Audio").shutdown()
 print("PASS: insufficient funds, exact wallet deduction, rank cap, pack cap, full-health rejection, charge consumption, retry persistence, state clamp")
 quit()
